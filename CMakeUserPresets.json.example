{
  "version": 3,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Dev (ninja + ccache)",
      "description": "Requires ccache on PATH (see README Prerequisites). Copy this file to CMakeUserPresets.json (gitignored) and adjust freely.",
      "inherits": ["ninja", "ccache"]
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "configuration": "Debug"
    },
    {
      "name": "dev-release",
      "configurePreset": "dev",
      "configuration": "Release"
    }
  ]
}
