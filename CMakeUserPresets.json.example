{
  "version": 3,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Dev (ninja + ccache)",
      "description": "Copy this file to CMakeUserPresets.json (gitignored) and adjust freely.",
      "inherits": ["ninja", "ccache"]
    },
    {
      "name": "dev-global",
      "displayName": "Dev (system vcpkg via $VCPKG_ROOT)",
      "description": "dev, but using a system-wide vcpkg from $VCPKG_ROOT.",
      "inherits": ["dev"],
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "configuration": "Debug"
    },
    {
      "name": "dev-release",
      "configurePreset": "dev",
      "configuration": "Release"
    },
    {
      "name": "dev-global",
      "configurePreset": "dev-global",
      "configuration": "Debug"
    }
  ]
}
