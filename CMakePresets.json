{
  "version": 3,
  "configurePresets": [
    {
      "name": "vcpkg",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "ccache",
      "hidden": true,
      "description": "Opt-in mixin — enable from your CMakeUserPresets.json (see CMakeUserPresets.json.example).",
      "cacheVariables": {
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
      }
    },
    {
      "name": "ninja",
      "displayName": "Ninja Multi-Config (bundled vcpkg)",
      "description": "On Windows, run from an x64 Native Tools developer prompt or use a VS Code CMake Tools kit.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build",
      "inherits": ["vcpkg"]
    },
    {
      "name": "vs",
      "displayName": "Visual Studio (x64)",
      "description": "Produces Atmospheric.sln in build-vs/ for the newest installed Visual Studio — no developer prompt needed.",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-vs",
      "inherits": ["vcpkg"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "ninja",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "ninja",
      "configuration": "Release"
    },
    {
      "name": "vs-debug",
      "configurePreset": "vs",
      "configuration": "Debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "vs-release",
      "configurePreset": "vs",
      "configuration": "Release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ]
}
